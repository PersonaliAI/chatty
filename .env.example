# Used by docker-compose.yml to bake NEXT_PUBLIC_* vars into the frontend
# build (Next.js requires these at build time, not just runtime). Copy this
# to .env in the repo root - values should match frontend/.env.example.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LEMON_PORTAL_URL=

# Self-host runtime (used by docker-compose.selfhost.yml)
POSTGRES_DB=chatty
POSTGRES_USER=chatty
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=chatty
S3_SECRET_KEY=change-me
S3_BUCKET=chatty
BACKEND_PORT=8000
FRONTEND_PORT=3000
