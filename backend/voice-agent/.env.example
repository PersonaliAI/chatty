# ─────────────────────────────────────────────────────────────────────────────
# Chatty Voice Worker — VPS Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Keys marked REQUIRED must be set. Optional keys have sensible defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── LiveKit Server ─────────────────────────────────────────────────────────
# REQUIRED: Your VPS public IP (used by LiveKit for ICE candidates).
LIVEKIT_HOST=YOUR_VPS_PUBLIC_IP

# REQUIRED: Domain pointing to this VPS (DNS A record → LIVEKIT_HOST).
DOMAIN=livekit.personaliai.com

# REQUIRED: Self-generated API key/secret pair.
# Generate with: docker run --rm livekit/livekit-server generate-keys
# Must match the key/secret in livekit.yaml.
LIVEKIT_API_KEY=CHATTY_VOICE_KEY
LIVEKIT_API_SECRET=CHATTY_VOICE_SECRET_REPLACE_ME

# ── Voice Worker ───────────────────────────────────────────────────────────
# Number of pre-warmed worker processes (each handles 1 concurrent call).
LIVEKIT_NUM_IDLE_PROCESSES=3

# Log level for the voice worker (DEBUG, INFO, WARNING, ERROR).
LIVEKIT_LOG_LEVEL=INFO

# ── Supabase ───────────────────────────────────────────────────────────────
# REQUIRED: Your Supabase project URL and service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── LLM ────────────────────────────────────────────────────────────────────
# REQUIRED: Gemini API key (used as the brain for voice responses).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── STT/TTS Provider Keys (Optional) ──────────────────────────────────────
# If a bot selects a non-Google provider but has no BYOK key configured,
# these server-side shared keys are used as fallback.
# Leave empty to fall back to Google STT/TTS (free tier / GCP default).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=

# ── BYOK Encryption ───────────────────────────────────────────────────────
# Key used to decrypt customer-supplied BYOK API keys stored in Supabase.
# Must match the key used by the Chatty API to encrypt them.
BYOK_ENCRYPTION_KEY=
