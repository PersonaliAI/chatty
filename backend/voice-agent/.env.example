# Chatty voice deployment configuration.
# Copy to .env and chmod 600. Supabase remains managed in both modes.
#
# Mode A — LiveKit Cloud (default):
#   LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
#   leave LIVEKIT_WORKER_URL empty and run `docker compose up -d --build`
#
# Mode B — self-hosted LiveKit on this VPS:
#   set DOMAIN and LIVEKIT_HOST, then run ./setup.sh
#   the script generates matching LiveKit keys and sets:
#   LIVEKIT_URL=wss://DOMAIN and LIVEKIT_WORKER_URL=ws://livekit:7880
#   start with `docker compose --profile self-hosted up -d --build`

# LiveKit endpoint used by the Chatty API and browser clients. In self-hosted
# mode this is the Caddy HTTPS/WSS hostname, not the internal Docker hostname.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_WORKER_URL=
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# Required only for self-hosted LiveKit mode.
DOMAIN=livekit.example.com
LIVEKIT_HOST=203.0.113.10

# Images are overrideable for controlled upgrades. Keep production versions
# pinned and update them deliberately.
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.7
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine

# Existing managed Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Shared Chatty voice brain
GEMINI_API_KEY=REPLACE_ME
BYOK_ENCRYPTION_KEY=REPLACE_ME

# Worker tuning
LIVEKIT_NUM_IDLE_PROCESSES=3
LIVEKIT_LOG_LEVEL=INFO

# Optional server-side provider fallbacks
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
SENTRY_DSN=
