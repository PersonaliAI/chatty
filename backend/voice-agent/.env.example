# Chatty voice-worker VPS configuration.
# Supabase and LiveKit Cloud stay managed. Copy to .env and chmod 600.

# LiveKit Cloud project credentials
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# Existing managed Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Shared Chatty voice brain
GEMINI_API_KEY=REPLACE_ME
BYOK_ENCRYPTION_KEY=REPLACE_ME

# Worker tuning
LIVEKIT_NUM_IDLE_PROCESSES=3
LIVEKIT_LOG_LEVEL=INFO

# Optional server-side provider fallbacks
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
SENTRY_DSN=
