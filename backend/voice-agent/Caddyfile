# ─────────────────────────────────────────────────────────────────────────────
# Caddy reverse proxy — auto-SSL for LiveKit WebSocket
# ─────────────────────────────────────────────────────────────────────────────
# Provisions a Let's Encrypt certificate automatically for the domain.
# Proxies HTTPS/WSS traffic to LiveKit's internal WebSocket port.
#
# The {$DOMAIN} placeholder is replaced by the DOMAIN env var from
# docker-compose.yml (defaults to livekit.personaliai.com).
# ─────────────────────────────────────────────────────────────────────────────

{$DOMAIN} {
    # Reverse proxy to LiveKit server's WebSocket port.
    # LiveKit uses WebSocket for signalling — Caddy upgrades HTTP → WS
    # automatically when the client sends an Upgrade header.
    reverse_proxy livekit:7880
}
