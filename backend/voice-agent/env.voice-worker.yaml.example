# Env for the chatty-voice-worker Cloud Run service (Dockerfile.voice-worker).
# A subset of env.yaml (the main API's env vars) — only what voice_worker.py
# actually reads via app.core.config / app.core.clients, plus the new
# LiveKit + STT/TTS provider vars. Same GCP project / Supabase project as the
# main API, so these are copies of the same real values already in env.yaml,
# not new secrets.

# --- LiveKit Cloud — same project kin-backend already uses (see its
# env.yaml), shared across both products. Isolation between the two voice
# workers comes from `agent_name` (this repo's voice_worker.py dispatches as
# "chatty-voice", kin-backend's as "kin-voice-agent" via
# LIVEKIT_VOICE_AGENT_NAME) — LiveKit Cloud routes room dispatch by that
# name, so both workers can share one project/account without colliding. ---
LIVEKIT_URL: "wss://YOUR-PROJECT.livekit.cloud"
LIVEKIT_API_KEY: "REPLACE_ME"
LIVEKIT_API_SECRET: "REPLACE_ME"

# --- Shared with the main API (app.core.clients / app.core.config) ---
GOOGLE_CLOUD_PROJECT: "REPLACE_ME"
GOOGLE_CLOUD_LOCATION: "global"
GEMINI_API_KEY: "REPLACE_ME"
# Voice-mode default model + Kin-style fallback chain (widget_brain.py).
GEMINI_VOICE_MODEL: "gemini-3.1-flash-lite"
KIN_FALLBACK_MODELS: "gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash"

SUPABASE_URL: "https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY: "REPLACE_ME"

# BYOK decrypt (voice_stt_byok_key_encrypted / voice_tts_byok_key_encrypted /
# byok_api_key_encrypted all use this same Fernet key — must match env.yaml).
BYOK_ENCRYPTION_KEY: "REPLACE_ME"

# --- Server-side shared STT/TTS provider keys — optional. Used only as a
# fallback when a bot picks a non-google provider but has no BYOK key of its
# own configured in the dashboard; leave blank to require BYOK for those. ---
DEEPGRAM_API_KEY: ""
ASSEMBLYAI_API_KEY: ""
SONIOX_API_KEY: ""
CARTESIA_API_KEY: ""
ELEVENLABS_API_KEY: ""
FISH_API_KEY: ""
OPENAI_API_KEY: ""

SENTRY_DSN: ""
