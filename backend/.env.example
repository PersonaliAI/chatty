# =============================================================================
# Chatty backend — environment configuration
# Copy this file to .env and fill in your own values.
# Only SUPABASE_*, GEMINI_API_KEY, and FUNCTION_SECRET are required to get a
# basic instance running. Everything else enables an optional feature/channel
# and can be left blank.
# =============================================================================

# --- Required: Supabase --------------------------------------------------
# Create a free project at https://supabase.com, then run every file in
# supabase/migrations/ against it (see README.md for the exact command).
# (The anon/public key goes in frontend/.env.example instead — this backend
# only ever talks to Supabase with the service_role key below.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy fallback — modern Supabase projects use JWKS and don't need this.
SUPABASE_JWT_SECRET=

# Direct Postgres connection (used for a couple of DDL operations that can't
# go through PostgREST). Find these in Supabase → Project Settings → Database.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Required: security ----------------------------------------------------
# Signs widget origin tokens + OAuth state JWTs, and gates /cron/* and
# /admin/*. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FUNCTION_SECRET=

# Symmetric key used to encrypt customer-supplied BYOK API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# --- Required: LLM (default = Gemini via Google AI Studio, free tier) ------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMMA_MODEL=gemini-2.5-flash
# Optional: use Vertex AI instead of/alongside AI Studio billing.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- URLs / CORS -------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: Voice agent (LiveKit) -----------------------------------------
# Create a free project at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_VOICE_MODEL=gemini-3.1-flash-lite
LIVEKIT_NUM_IDLE_PROCESSES=1
LIVEKIT_LOG_LEVEL=INFO
# Server-side shared STT/TTS provider keys — optional fallback when a bot
# picks a non-Google provider but has no BYOK key of its own. Google STT/TTS
# needs no key here (uses GOOGLE_CLOUD_PROJECT's application default creds).
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
FISH_API_KEY=
OPENAI_API_KEY=

# --- Optional: WhatsApp channel (Meta Cloud API) -----------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Optional: Slack channel --------------------------------------------------
SLACK_SIGNING_SECRET=

# --- Optional: Google OAuth (Calendar + Gmail read for bookings) ------------
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Optional: Microsoft 365 (Azure AD) --------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# --- Optional: transactional email/push (OneSignal) --------------------------
# Leave blank to fall back to the bot owner's connected Gmail, or just log.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_EMAIL_FROM=
ONESIGNAL_EMAIL_FROM_NAME=

# --- Optional: real Zoom meeting links (Server-to-Server OAuth) -------------
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us with the
# meeting:write:meeting scope. A single backend-wide credential (unlike
# Google/Microsoft, there's no per-user "connect your Zoom account" flow).
# Leave blank and bookings fall back to a placeholder link instead of a
# broken one; GET /api/capabilities reports whether this is configured.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Optional: web search / crawl (Jina AI) ----------------------------------
# Leave blank and web search degrades gracefully to a keyless tier.
JINA_API_KEY=

# --- Optional: billing (Lemon Squeezy) ---------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# --- Optional: cross-instance rate limiting (Upstash Redis REST) ------------
# Leave blank to fall back to in-process rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: error monitoring (Sentry) -------------------------------------
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Optional: retention / admin -------------------------------------------
CHATTY_RETENTION_DAYS=90
ADMIN_ALERT_EMAIL=

PORT=8000
