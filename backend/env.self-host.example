# Copy to .env.self-host (ignored) and replace every placeholder.
# The managed Supabase profile remains the default when this file is not used.
DEPLOYMENT_PROFILE=self_host

# API/runtime
PORT=8080
CHATTY_BACKEND_URL=https://chatty-api.example.com
CHATTY_FRONTEND_URL=https://chatty.example.com
FRONTEND_URL=https://chatty.example.com
ALLOWED_ORIGINS=https://chatty.example.com
GEMINI_API_KEY=replace-with-a-server-side-llm-key

# PostgreSQL / Redis (the compose file fills these service names in)
POSTGRES_DB=chatty
POSTGRES_USER=chatty
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://chatty:replace-with-a-long-random-password@postgres:5432/chatty
REDIS_URL=redis://redis:6379/0
CHATTY_JOB_QUEUE_URL=redis://redis:6379/0

# MinIO/S3. Keep the bucket private in production and put a TLS reverse proxy
# in front of it; S3_PUBLIC_URL is the externally reachable object URL prefix.
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-32-character-random-secret
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-32-character-random-secret
S3_BUCKET=chatty
S3_PUBLIC_URL=https://objects.example.com/chatty

# OIDC (Google issuer is supported; use your own issuer for production).
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_AUDIENCE=replace-with-your-oidc-client-id

# Operational security
FUNCTION_SECRET=replace-with-a-long-random-secret
SENTRY_ENV=self-host
LOG_LEVEL=INFO
