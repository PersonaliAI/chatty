# Signs widget origin tokens + OAuth state JWTs; gates /cron/* and /admin/*.
# Rotating it requires a Cloud Run env update + all Cloud Scheduler job URIs.
#
# NOTE: TELEGRAM_BOT_TOKEN and a Telegram channel/webhook used to be
# documented here (this comment referenced a POST /admin/telegram/
# setup-webhook endpoint) but no such endpoint, router, or env var read
# exists anywhere in this codebase today — confirmed by an exhaustive grep,
# not just a missing router file. Either removed without cleaning up this
# file, or never actually built. Don't set TELEGRAM_BOT_TOKEN expecting it
# to do anything; if Telegram support gets (re)built, document it here then.
FUNCTION_SECRET: "REPLACE_ME"
GOOGLE_CLOUD_PROJECT: "REPLACE_ME"
GOOGLE_CLOUD_LOCATION: "global"
KIN_MODEL: "gemini-2.5-flash-lite"
# Ordered fallback chain, tried in sequence on any failure (quota/429,
# transient 5xx, or a thought_signature 400 from a mismatched model — see
# main.py's GEMINI_FALLBACK_MODELS comment). gemini-3.1-flash-lite and
# gemini-3.5-flash-lite have by far the most free-tier daily-request
# headroom (500 RPD vs 20 RPD on the 2.5 models per AI Studio's quota
# dashboard), so they're worth trying even though they're a different
# model generation — a failure there just advances to the next entry.
KIN_FALLBACK_MODELS: "gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash"

# Google AI Studio API key (free tier) — set to route Gemini calls through
# AI Studio's own billing instead of Vertex AI. Vertex AI config above stays
# in place as the fallback path when this is blank. Get/rotate at
# https://aistudio.google.com/apikey
GEMINI_API_KEY: "REPLACE_ME"


# Direct Postgres connection (used for dynamic ALTER TABLE on leads).
# Prefer Google Secret Manager for this in production.
SUPABASE_DB_PASSWORD: "REPLACE_ME"

SUPABASE_URL: "https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY: "REPLACE_ME"

# Optional: only used as a fallback if the project ever serves HS256 tokens.
# The modern flow is JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET: ""

# Google OAuth — REDIRECT_URI must match the one set in Google Cloud Console.
GOOGLE_CLIENT_ID: "REPLACE_ME"
GOOGLE_CLIENT_SECRET: "REPLACE_ME"
GOOGLE_REDIRECT_URI: "https://api.chatty.personaliai.com/auth/google/callback"

# Where the backend redirects after OAuth completes. Fallback only — Kin's own
# integration-connect flow always sends its real Origin header, which is
# validated against ALLOWED_ORIGINS below. Kin owns all /dashboard/* routes,
# so this must point at kin.personaliai.com, not chatty.
FRONTEND_URL: "https://kin.personaliai.com"

# CORS — comma-separated. Must include every domain that calls this API from
# the browser: kin app, marketing umbrella, chatty app, and local dev.
ALLOWED_ORIGINS: "https://kin.personaliai.com,https://personaliai.com,https://chatty.personaliai.com,https://chatty--personaliai.us-central1.hosted.app,http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Chatty's own frontend (the OAuth consent screen lives here — separate from
# FRONTEND_URL above, which is pinned to Kin's dashboard) and this service's
# own public URL (the OAuth issuer/MCP resource identifiers advertised in
# metadata — must match the domain this API is actually reached at). Both
# default to production values already; only set these if you're pointing
# this service at a different domain.
# CHATTY_FRONTEND_URL: "https://chatty.personaliai.com"
# CHATTY_BACKEND_URL: "https://api.chatty.personaliai.com"

# Admin / billing bypass emails (comma-separated). Users listed here get lifetime
# business plan access and unlimited message/token quotas.
ADMIN_BYPASS_EMAILS: "personaliai.com@gmail.com"

# Lemon Squeezy
LEMONSQUEEZY_API_KEY: "REPLACE_ME"
LEMONSQUEEZY_WEBHOOK_SECRET: "REPLACE_ME"
LEMONSQUEEZY_STORE_ID: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_BASIC: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_PRO: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_EXECUTIVE: "REPLACE_ME"
# Chatty billing tiers — same store: Hobby $19/mo, Standard $99/mo,
# Business $399/mo, plus discounted yearly variants.
LEMONSQUEEZY_VARIANT_CHATTY_HOBBY: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_CHATTY_STANDARD: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_CHATTY_BUSINESS: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_CHATTY_HOBBY_YEARLY: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_CHATTY_STANDARD_YEARLY: "REPLACE_ME"
LEMONSQUEEZY_VARIANT_CHATTY_BUSINESS_YEARLY: "REPLACE_ME"

# Microsoft 365 (Azure AD) — register an app at https://entra.microsoft.com
# and point its redirect to https://YOUR-CLOUD-RUN-URL/auth/microsoft/callback
MICROSOFT_CLIENT_ID: "REPLACE_ME"
MICROSOFT_CLIENT_SECRET: "REPLACE_ME"
MICROSOFT_REDIRECT_URI: "https://api.chatty.personaliai.com/auth/microsoft/callback"

# OneSignal — transactional meeting emails + push.
# Create an app at https://onesignal.com, enable the Email channel, verify a
# sender, then paste the App ID and a REST API Key below. Leave blank to fall
# back to the bot owner's connected Gmail (or just log if neither is set).
ONESIGNAL_APP_ID: "REPLACE_ME"
ONESIGNAL_REST_API_KEY: "REPLACE_ME"
ONESIGNAL_EMAIL_FROM: "chatty@personaliai.com"
ONESIGNAL_EMAIL_FROM_NAME: "Chatty Team"

# Zoom Server-to-Server OAuth — real meeting links for bots configured with
# meeting_provider="zoom" (plugins/zoom_integration.py). Create a
# Server-to-Server OAuth app at https://marketplace.zoom.us with the
# meeting:write:meeting scope; account_id/client_id/client_secret come from
# that app. A single backend-wide credential — no per-user connect flow,
# unlike Google/Microsoft. GET /api/capabilities reports zoom_configured
# based on whether all three are set; leave blank and bookings fall back to
# a placeholder link instead of a broken one.
ZOOM_ACCOUNT_ID: "REPLACE_ME"
ZOOM_CLIENT_ID: "REPLACE_ME"
ZOOM_CLIENT_SECRET: "REPLACE_ME"

# BYOK: symmetric key used to encrypt customer-supplied OpenAI/Anthropic/OpenRouter
# keys at rest. Rotating this invalidates all stored BYOK keys.
BYOK_ENCRYPTION_KEY: "REPLACE_ME"

# Upstash Redis (REST) — shared cross-instance rate limiting for widget endpoints.
UPSTASH_REDIS_REST_URL: "https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN: "REPLACE_ME"

# Sentry error monitoring. Paste the DSN from sentry.io project settings to enable.
# Empty = monitoring disabled (no-op).
SENTRY_DSN: ""

# WhatsApp channel (Meta Cloud API). Empty = channel disabled.
# VERIFY_TOKEN is any string you also enter in the Meta webhook config; ACCESS_TOKEN
# is the permanent token from your Meta app. Link a bot to a number by setting
# chatty_bots.whatsapp_phone_number_id.
WHATSAPP_VERIFY_TOKEN: ""
WHATSAPP_ACCESS_TOKEN: ""

# Slack channel. Empty = disabled. Set to your Slack app's Signing Secret and
# link a bot via chatty_bots.slack_team_id.
SLACK_SIGNING_SECRET: ""

# Jina AI key — powers both web_search (s.jina.ai) and crawl reader (r.jina.ai).
# Empty = web search degrades gracefully; crawl falls back to the keyless tier.
JINA_API_KEY: ""

# System alert emails (e.g. Telegram webhook going silently empty) go here
# via OneSignal — not tied to any particular Kin user.
ADMIN_ALERT_EMAIL: ""

# Resend — transactional email provider. Preferred over OneSignal's email
# channel when set; EMAIL_PROVIDER_PREFERRED selects which one is tried first.
RESEND_API_KEY: "REPLACE_ME"
RESEND_EMAIL_FROM: "Chatty Team <chatty@personaliai.com>"
EMAIL_PROVIDER_PREFERRED: "resend"
