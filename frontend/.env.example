# =============================================================================
# Chatty frontend — environment configuration
# Copy this file to .env.local (local dev) or .env (Docker) and fill in your
# own values. Must point at the SAME Supabase project as the backend's .env.
# =============================================================================

# --- Required ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL of the chatty-backend API (see ../backend). Default matches
# docker-compose.yml's service name/port.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Optional: billing (Lemon Squeezy) ---------------------------------------
# Leave all of these blank to disable billing/upgrade UI entirely.
NEXT_PUBLIC_LEMON_PORTAL_URL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_VARIANT_CHATTY_HOBBY=
LEMONSQUEEZY_VARIANT_CHATTY_STANDARD=
LEMONSQUEEZY_VARIANT_CHATTY_BUSINESS=
LEMONSQUEEZY_VARIANT_CHATTY_HOBBY_YEARLY=
LEMONSQUEEZY_VARIANT_CHATTY_STANDARD_YEARLY=
LEMONSQUEEZY_VARIANT_CHATTY_BUSINESS_YEARLY=
