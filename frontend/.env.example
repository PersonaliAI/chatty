# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL. For Docker Compose on one host, use http://localhost:8000.
# For a hosted deployment, use the public HTTPS URL of the backend service.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# The supported deployment path keeps Supabase Auth/Postgres/Storage managed
# and moves only the Chatty frontend/backend containers to your host.
NEXT_PUBLIC_DEPLOYMENT_PROFILE=managed_supabase

# Polar.sh Platform Billing (for subscription purchases)
POLAR_ACCESS_TOKEN=your_polar_organization_access_token
POLAR_ENVIRONMENT=live
POLAR_PRODUCT_CHATTY_HOBBY=your_polar_hobby_product_id
POLAR_PRODUCT_CHATTY_HOBBY_YEARLY=your_polar_hobby_yearly_product_id
POLAR_PRODUCT_CHATTY_STANDARD=your_polar_standard_product_id
POLAR_PRODUCT_CHATTY_STANDARD_YEARLY=your_polar_standard_yearly_product_id
POLAR_PRODUCT_CHATTY_BUSINESS=your_polar_business_product_id
POLAR_PRODUCT_CHATTY_BUSINESS_YEARLY=your_polar_business_yearly_product_id
NEXT_PUBLIC_POLAR_PORTAL_URL=https://polar.sh/purchases
NEXT_PUBLIC_CHATTY_AFFILIATE_SIGNUP_URL=your_affiliate_signup_url

# Firebase (web app config — these are public identifiers, not secrets;
# restricted via Firebase Security Rules / API key restrictions, same as any
# Firebase web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# CARTO Basemaps API Key (for Client Geolocation Map without watermarks)
# Free 1M requests/mo key from https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=your_carto_basemaps_api_key
