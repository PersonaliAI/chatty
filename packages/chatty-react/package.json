{
  "name": "@personaliai/react-widget",
  "version": "0.2.0",
  "description": "Embed the Chatty chat assistant directly in a React app — no iframe, calls the Chatty API directly. Same UI and behavior as the hosted embed.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "chatty",
    "chatbot",
    "chat-widget",
    "react",
    "ai",
    "customer-support"
  ],
  "homepage": "https://chatty.personaliai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/PersonaliAI/chatty.git",
    "directory": "packages/chatty-react"
  },
  "bugs": "https://github.com/PersonaliAI/chatty/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./widget-style": {
      "types": "./dist/widget-style.d.ts",
      "import": "./dist/widget-style.js",
      "require": "./dist/widget-style.cjs"
    },
    "./color-contrast": {
      "types": "./dist/color-contrast.d.ts",
      "import": "./dist/color-contrast.js",
      "require": "./dist/color-contrast.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^12.38.0",
    "katex": "^0.16.45",
    "livekit-client": "^2.22.0",
    "lucide-react": "^1.14.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5"
  }
}
